+
+app.get<{ Params: { id: string } }>("/api/orders/:id/live", async (req, reply) => {
+  const order = get.get(Number(req.params.id)) as Row | undefined;
+  if (!order) return reply.code(404).send({ error: "Order not found" });
+  if (!order.token) return reply.send({ status: order.status, isLive: false });
+
+  try {
+    const endpoint = \`https://api.grab.com/api/v1/safety/sharemyride/\${encodeURIComponent(order.token)}/bookingdetails?fullData=true\`;
+    const res = await fetch(endpoint, {
+      headers: {
+        Origin: "https://sharelocation.grab.com",
+        Referer: \`https://sharelocation.grab.com/o/\${order.token}\`,
+        "User-Agent": "Mozilla/5.0 (Linux; Android 13; Pixel 7) AppleWebKit/537.36 Chrome/120 Mobile Safari/537.36",
+      },
+      signal: AbortSignal.timeout(5000),
+    });
+
+    if (res.status === 404) {
+      update.run(order.token, "EXPIRED", new Date().toISOString(), order.id);
+      return reply.send({ status: "EXPIRED", isLive: false });
+    }
+    
+    if (!res.ok) return reply.code(502).send({ error: "Failed to fetch from Grab" });
+
+    const data = await res.json();
+    return reply.send({ isLive: true, ...data });
+  } catch (e) {
+    return reply.code(500).send({ error: "Proxy error" });
+  }
+});
+
