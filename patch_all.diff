+@Composable
+fun LiveTrackingDialog(
+    orderId: Int,
+    onClose: () -> Unit,
+    request: (String, String, String?, (Result<String>) -> Unit) -> Unit
+) {
+    var liveData by remember { mutableStateOf<JSONObject?>(null) }
+    var error by remember { mutableStateOf("") }
+
+    LaunchedEffect(orderId) {
+        while (true) {
+            request("/api/orders/$orderId/live", "GET", null) { result ->
+                result.fold(
+                    onSuccess = { text ->
+                        try {
+                            liveData = JSONObject(text)
+                            error = ""
+                        } catch (e: Exception) {
+                            error = "Format error"
+                        }
+                    },
+                    onFailure = { error = it.message ?: "Network error" }
+                )
+            }
+            delay(5000)
+        }
+    }
+
+    Dialog(onDismissRequest = onClose) {
+        Card(
+            modifier = Modifier.fillMaxWidth().padding(16.dp),
+            shape = RoundedCornerShape(16.dp),
+            colors = CardDefaults.cardColors(containerColor = Color.White)
+        ) {
+            Column(Modifier.padding(20.dp)) {
+                Text("Live Tracking", style = MaterialTheme.typography.titleLarge, fontWeight = FontWeight.Bold, color = Color(0xFFEA580C))
+                Spacer(Modifier.height(12.dp))
+                
+                if (error.isNotEmpty()) {
+                    Text(error, color = MaterialTheme.colorScheme.error)
+                } else if (liveData == null) {
+                    CircularProgressIndicator(modifier = Modifier.align(Alignment.CenterHorizontally))
+                } else {
+                    val isLive = liveData?.optBoolean("isLive") == true
+                    if (!isLive) {
+                        Text("Order is no longer active.")
+                    } else {
+                        val driver = liveData?.optJSONObject("driver")?.optString("name", "Unknown Driver")
+                        val status = liveData?.optJSONObject("messageStatus")?.optString("title", "Tracking...")
+                        val plate = liveData?.optJSONObject("driver")?.optString("vehiclePlateNumber", "")
+                        
+                        Text("Status: $status", fontWeight = FontWeight.SemiBold)
+                        Spacer(Modifier.height(8.dp))
+                        Text("Driver: $driver")
+                        if (!plate.isNullOrEmpty()) {
+                            Text("Plate: $plate", style = MaterialTheme.typography.bodyMedium)
+                        }
+                    }
+                }
+                Spacer(Modifier.height(16.dp))
+                TextButton(onClick = onClose, modifier = Modifier.align(Alignment.End)) { Text("Close") }
+            }
+        }
     }
 }
